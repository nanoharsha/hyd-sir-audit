{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyd-sir-audit",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /live/data and /live/events are listed as exact paths, not "/live/*",
    // so that /live/ itself keeps being served as a static asset from
    // public/live/index.html.
    "run_worker_first": ["/api/*", "/live/data", "/live/events"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyd-sir-audit-db",
      // Created 2026-10-23 in the APAC region, so the roll stays in Asia-Pacific.
      "database_id": "00a02fc8-9c46-414f-a220-bdd25ec0207e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "hyd-sir-audit-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BROADCAST",
        "class_name": "BroadcastRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BroadcastRoom"]
    }
  ],
  // No custom domain yet — Hyderabad runs on its workers.dev address for now.
  // Delhi's "routes" entry (delhi.sirpublicaudit.app) was removed: that hostname
  // belongs to the Delhi deployment.
  //
  // Before attaching ANY custom hostname here, it MUST first be covered by a
  // Cloudflare Access application: the app has no login of its own and trusts the
  // Cf-Access-Authenticated-User-Email header, so an un-gated hostname exposes the
  // whole roll (see CLAUDE.md, "The Access configuration").
  //
  // Decide the hostname BEFORE surveyors start work, not after: a phone's offline
  // outbox (IndexedDB) belongs to the ORIGIN it was created on, so moving address
  // later strands anyone's unsynced entries.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SUPER_ADMIN_EMAILS": "sreeharsha@hey.com"
  }
}
